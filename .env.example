# ─────────────────────────────────────────────────────────────────────────────
# Joy of Dentistry — environment configuration
#
# Copy this file to `.env.local` and fill in the values. The site runs in a
# clean, safe "not yet configured" state when Supabase is absent, so you can
# develop the UI before provisioning a backend.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (auth + database + storage) ────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the client. Used by the seed
# script and by trusted admin server actions for storage uploads.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin access control ─────────────────────────────────────────────────────
# Comma-separated list of email addresses allowed into /admin. A matching
# Supabase Auth user must exist for each (create via the seed script or the
# Supabase dashboard). Admin privileges are enforced server-side.
ADMIN_EMAILS=

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public origin (no trailing slash). Used for canonical URLs,
# hreflang, sitemap, and social/Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Max upload size in megabytes for covers and PDFs (admin workflow).
NEXT_PUBLIC_MAX_COVER_MB=10
NEXT_PUBLIC_MAX_PDF_MB=60

# ── Contact form delivery (optional) ─────────────────────────────────────────
# The contact form only appears when a real delivery service is configured.
# Leave blank to hide the form and show contact details only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ── Newsletter (optional) ────────────────────────────────────────────────────
# The newsletter signup only appears when configured. Supported: "resend"
# (stores confirmed subscribers via a Resend Audience). Leave blank to hide.
NEWSLETTER_PROVIDER=
RESEND_AUDIENCE_ID=
